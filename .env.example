DJANGO_SECRET_KEY=change-me
# 1 for local development, 0 in production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# production, e.g. https://cites.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# set to 0 only if serving over plain http (not recommended)
DJANGO_SECURE_COOKIES=1
# sqlite (default) or postgres://user:pass@host:5432/db
DATABASE_URL=
# docker-compose only
POSTGRES_PASSWORD=
MEDIA_ROOT=./media
SPECIESPLUS_TOKEN=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=cites@localhost
# local demo user created by `manage.py seed_demo` (never use in production)
DEMO_PASSWORD=demo-cites-2026

# --- Who runs this instance, shown in Termini / Privacy (keep real values out of git) ---
SITE_NAME=CITES Manager
# your name (private person: personal, non-commercial project)
LEGAL_NAME=
LEGAL_EMAIL=
# city of the competent court
LEGAL_FORUM=
# bump (YYYY-MM-DD) whenever the Terms change: every user must accept again
LEGAL_UPDATED=2026-10-18

# --- AI reading of imported documents (Regolo.ai, EU) ---
# Normally each profile owner sets their own key in "Dati detentore" (stored encrypted).
# Optional server-wide fallback for single-user self-hosted installs:
REGOLO_API_KEY=
AI_OCR_MODEL=deepseek-ocr-2
AI_EXTRACT_MODEL=qwen3.5-122b
# documents read with lower confidence are left for manual review
AI_MIN_CONFIDENCE=0.75
