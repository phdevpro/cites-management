# --- Portainer stack environment for deploy/portainer-stack.yml ---
CITES_HOST=cites.example.com
CITES_VERSION=latest

# generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

DB_USERNAME=cites
DB_PASSWORD=change-me
DB_DATABASE_NAME=cites

# uploaded documents: host path (e.g. NFS share, writable by uid 1000);
# leave empty to use the named volume "cites-media"
MEDIA_LOCATION=/media/CITESmanager/media
# nightly Postgres dumps (live DB stays in the local named volume "cites-db-data")
DBBK_LOCATION=/media/CITESmanager/db-backups

# e-mail reminders (optional; empty = logged only)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=cites@example.com

SPECIESPLUS_TOKEN=

# --- Who runs this instance, shown in Termini / Privacy (keep real values out of git) ---
SITE_NAME=CITES Manager
# your name (private person: personal, non-commercial project)
LEGAL_NAME=
LEGAL_EMAIL=
# city of the competent court
LEGAL_FORUM=
# bump (YYYY-MM-DD) whenever the Terms change: every user must accept again
LEGAL_UPDATED=2026-10-18

# --- AI reading of imported documents (Regolo.ai, EU) ---
# Normally each profile owner sets their own key in "Dati detentore" (stored encrypted).
# Optional server-wide fallback for single-user self-hosted installs:
REGOLO_API_KEY=
AI_OCR_MODEL=deepseek-ocr-2
AI_EXTRACT_MODEL=qwen3.5-122b
# documents read with lower confidence are left for manual review
AI_MIN_CONFIDENCE=0.75

# --- Hardening ---
# Django admin path (pick something not guessable) and optional IP allowlist (IPs/CIDRs, comma-separated)
ADMIN_URL=admin/
ADMIN_ALLOWED_IPS=
# proxies in front of the app that append X-Forwarded-For: 1 = Traefik only,
# 2 = Cloudflare proxy (orange cloud) + Traefik with Cloudflare ranges in forwardedHeaders.trustedIPs
TRUSTED_PROXY_COUNT=1
# 0 = no self-registration (private instance: create users with createsuperuser / admin)
ALLOW_SIGNUP=1
# Cloudflare Turnstile on signup (free; leave empty to disable)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 1 = send Content-Security-Policy as report-only (debug); default enforced
CSP_REPORT_ONLY=0
# two-factor authentication: staff (default) | all | none
OTP_REQUIRED_FOR=staff
# security.txt contact (defaults to LEGAL_EMAIL)
SECURITY_CONTACT=
