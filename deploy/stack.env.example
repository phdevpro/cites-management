# --- Portainer stack environment for deploy/portainer-stack.yml ---
CITES_HOST=cites.example.com
CITES_VERSION=latest

# generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

DB_USERNAME=cites
DB_PASSWORD=change-me
DB_DATABASE_NAME=cites

# uploaded documents: host path (e.g. NFS share, writable by uid 1000);
# leave empty to use the named volume "cites-media"
MEDIA_LOCATION=/media/CITESmanager/media
# nightly Postgres dumps (live DB stays in the local named volume "cites-db-data")
DBBK_LOCATION=/media/CITESmanager/db-backups

# e-mail reminders (optional; empty = logged only)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=cites@example.com

SPECIESPLUS_TOKEN=
